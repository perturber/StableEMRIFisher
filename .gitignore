# MCMC comparison: track the script, the injection configs and the README, not the run outputs
/examples/check_against_mcmc/*
!/examples/check_against_mcmc/README.md
!/examples/check_against_mcmc/exec.py
!/examples/check_against_mcmc/plot_results.py
!/examples/check_against_mcmc/metrics.py
!/examples/check_against_mcmc/injection_config*.py
